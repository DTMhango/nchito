# Deployment settings only. Business choices (thresholds, caps, models, themes...) live in the
# app's Settings screen, backed by backend/app/core/settings/registry.py.

# development | production | test. Production requires ENCRYPTION_KEY.
ENVIRONMENT=development

# Compose builds DATABASE_URL from this password; set DATABASE_URL directly when running outside compose.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://nchito:change-me@localhost:5432/nchito

# Signs session cookies. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Fernet key for provider tokens at rest. Generate: docker compose run --rm web nchito gen-key
# Never stored in the database or in backups: keep a copy somewhere safe.
ENCRYPTION_KEY=

# Public URL of the app (https in production; cookies are Secure when this is https).
BASE_URL=http://localhost:8000

# Default product name; the owner's App name setting overrides it.
APP_NAME=Nchito

# Where documents, snapshots and backups live (a volume in compose).
FILES_DIR=/data/files

# Extra origins allowed to make state-changing requests (comma-separated), e.g. a dev server.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Local web port (compose).
WEB_PORT=8000

# Dokploy only.
# DOMAIN=jobs.example.com

# Optional S3-compatible backup target.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Backups: where archives are written, and (only if pg_dump is not on PATH) where it lives.
# BACKUP_DIR=./data/backups
# PG_BIN_DIR=

# Google sign-in for the Gmail and Drive connections: one OAuth client from the Google Cloud console.
# Authorised redirect URIs: BASE_URL + /api/connections/oauth/gmail/callback and
#                           BASE_URL + /api/connections/oauth/gdrive/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft sign-in for the Outlook and OneDrive connections: one Entra app registration.
# Redirect URIs (Web): BASE_URL + /api/connections/oauth/msgraph/callback and
#                      BASE_URL + /api/connections/oauth/onedrive/callback
# MS_OAUTH_TENANT: common (work, school and personal), consumers, organizations, or a tenant id.
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# MS_OAUTH_TENANT=common

LOG_LEVEL=INFO
